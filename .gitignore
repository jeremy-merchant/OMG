/.omg/private/
/.omg/*.db
/.omg/*.db-*
/.omg/backups/
/.omg/locks/
/.omg/reports/
/.omg/views/

# Local secrets and workstation metadata.
.env
.env.*
!.env.example
.DS_Store

# Cross-compiled Go test executables generated at the repository root.
/*.test.exe

# Local builds, test captures, and one-session implementation scratch files.
/bin/
/.tmp/
